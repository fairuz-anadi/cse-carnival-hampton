# Copy this file to .env and fill in ONE model key. Never commit your real .env.

# --- LLM (pick one) ---
# Google AI Studio — free tier, get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-4o-mini

# Groq
# GROQ_API_KEY=your_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Database ---
# SQLite file. Created and seeded automatically on first run; no setup needed.
# DATABASE_PATH=./campusos.db
