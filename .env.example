# Copy this file to .env and fill in ONE model key.
#   macOS/Linux:  cp .env.example .env
#   Windows cmd:  copy .env.example .env
# .env is gitignored. Never commit your real key.

# --- Which provider to use ---
# Optional. Set it when more than one key below is filled in, otherwise the
# first key found wins (Google, then OpenAI, then Groq) and you may not get the
# one you meant. Values: gemini | openai | groq
# LLM_PROVIDER=openai

# --- Google Gemini ---
# Free key: https://aistudio.google.com/apikey
# WARNING: the free tier allows only 20 requests per DAY. One question costs the
# agent 2-4 requests, so a free key runs dry after roughly six questions. Enough
# for a quick look, not enough to work through the app.
GOOGLE_API_KEY=your_key_here
# GEMINI_MODEL=gemini-3.6-flash

# --- OpenAI (paid, no meaningful rate limit) ---
# https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-4o-mini

# --- Groq (free, far more generous limits than Gemini) ---
# https://console.groq.com/keys
# GROQ_API_KEY=your_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Database ---
# SQLite file. Created and seeded from data/*.json on first run; no setup needed.
# DATABASE_PATH=./campusos.db
